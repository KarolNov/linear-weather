{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linear-weather-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Login sessions (Linear OAuth tokens). Pinned by id: without one, a deploy that can't tell the
  // live binding apart tries to create the namespace again and fails on its taken name.
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "b9184f0064d04b6a9992a4a2d89b29bb" }],
  // Team rules and quadrant overrides (src/db/tables.ts), pinned by id like the sessions.
  // `pnpm --filter server db:migrate:remote` creates its tables.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linear-weather",
      "database_id": "a71ccd43-3234-4cdb-aeef-2b33f9742768",
      "migrations_dir": "migrations"
    }
  ],
  // One channel per Linear team (src/team-channel.ts): each board's live subscription listens on
  // it, and Linear's webhooks and the board's own changes publish to it.
  "durable_objects": { "bindings": [{ "name": "TEAM_CHANNELS", "class_name": "TeamChannel" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TeamChannel"] }],
  // LINEAR_API_KEY is an optional dev shortcut, typed in src/env.d.ts.
  "secrets": { "required": ["LINEAR_CLIENT_ID", "LINEAR_CLIENT_SECRET", "LINEAR_WEBHOOK_SECRET"] },
  // Worker Previews (each non-main branch) don't inherit the bindings above. They share a staging
  // database and session store, so unmerged code never touches production data. Secrets come
  // from `wrangler preview base-config secret put`. scripts/preview.sh migrates the database.
  "previews": {
    "kv_namespaces": [{ "binding": "SESSIONS", "id": "a1b9058f31e0424598eaaa73ac85e7db" }],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "linear-weather-preview",
        "database_id": "1eece4f3-d0c2-4d9d-8456-7a3bc1ad1e78"
      }
    ],
    "durable_objects": { "bindings": [{ "name": "TEAM_CHANNELS", "class_name": "TeamChannel" }] }
  }
}
