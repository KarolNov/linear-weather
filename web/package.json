{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter server db:migrate:local --persist-to ../web/.wrangler/state && vite",
    "build": "pnpm codegen:check && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc -p . && tsc -p scripts",
    "codegen": "graphql-codegen && tsx scripts/trusted-documents.ts",
    "codegen:check": "graphql-codegen --check && tsx scripts/trusted-documents.ts --check",
    "codegen:prune": "tsx scripts/trusted-documents.ts --prune",
    "demo-gif": "tsx scripts/demo-gif.ts"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.1",
    "hono": "^4.13.13",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.8.1",
    "ui": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@preact/preset-vite": "^2.10.6",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/node": "26.6.5",
    "@vitest/browser-playwright": "^5.0.5",
    "graphql": "^17.0.2",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
