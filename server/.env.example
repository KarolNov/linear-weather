# Copy to server/.env for local dev. In production use `wrangler secret put <NAME>`.

# Linear OAuth app (Settings → API → OAuth applications). See the README for setup.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Optional dev shortcut: a personal API key (Settings → Security & access → Personal API keys).
# Only honored for requests to localhost, and only when nobody is signed in.
# Leave it empty to exercise the real OAuth login.
LINEAR_API_KEY=

# Optional dev shortcut: set to true to browse a mocked Avengers workspace as Nick Fury, with
# no Linear account. Like the API key, only for localhost and only when nobody is signed in.
LINEAR_DEMO=

# Signing secret for Linear webhooks (Settings → API → Webhooks)
LINEAR_WEBHOOK_SECRET=
